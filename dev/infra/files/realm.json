{
  "realm": "gpp-local",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "roles": {
    "realm": [
      {
        "name": "odpc-admin",
        "description": "GPP-app administrator"
      },
      {
        "name": "odbp-admin",
        "description": "GPP-burgerportaal administrator"
      },
      {
        "name": "odrc-admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "odpc",
      "name": "GPP-app (odpc)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "odpc-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8130/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        }
      ]
    },
    {
      "clientId": "odbp",
      "name": "GPP-burgerportaal (odbp)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "odbp-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8140/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        }
      ]
    },
    {
      "clientId": "odrc",
      "name": "GPP-publicatiebank (odrc)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "odrc-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "usermodel.realmRoleMapping.rolePrefix": ""
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "totp",
          "secretData": "{\"value\":\"gpp-admin-otp-seed-0001\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "odpc-admin",
        "odbp-admin",
        "odrc-admin"
      ]
    },
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "user@example.com",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "totp",
          "secretData": "{\"value\":\"gpp-user-otp-seed-0001\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ],
      "requiredActions": [],
      "realmRoles": []
    }
  ]
}